NODE_ENV=development

DATABASE_URL=postgresql://linkedout:linkedout@localhost:5432/linkedout

# Optional, only needed when DATABASE_URL points at a connection pooler (e.g.
# Supabase's transaction-mode pooler, port 6543) rather than Postgres
# directly. drizzle-kit push/generate/migrate need a session-capable
# connection — transaction-mode pooling can break the advisory locks and
# multi-statement DDL migrations rely on — so point this at the same
# database's session-mode pooler (port 5432) or a direct connection instead.
# Falls back to DATABASE_URL when unset (fine for a plain, unpooled Postgres
# like docker-compose's or CI's). See drizzle.config.ts.
DIRECT_DATABASE_URL=

# Optional. Caps how many concurrent connections the API opens to Postgres.
# Safe to raise well past 15 when DATABASE_URL is a transaction-mode pooler
# (it multiplexes many client connections over far fewer real Postgres
# backends) — see packages/database/src/client.ts. Keep it near/under 15 only
# if DATABASE_URL is a session-mode pooler or a direct connection.
DATABASE_MAX_CONNECTIONS=20

# Required. Must be a strong, unique secret in any real deployment -- the
# API refuses to start without it. docker-compose.yml sets a literal
# 'dev-secret' value for local dev only; never reuse that value anywhere
# other than a local machine.
JWT_SECRET=change-me

# Optional. Per-IP rate limit for the API (see apps/api/src/app.module.ts).
# Defaults to 120 requests / 60000ms. Raise RATE_LIMIT_MAX when running
# load-tests/browse.js so it measures real throughput instead of 429s.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Optional. Pino log level for the API (trace|debug|info|warn|error|fatal).
LOG_LEVEL=info

# Optional. Origin the frontend is served from, used to build links sent in
# emails (e.g. the email-verification link). Falls back to
# http://localhost:3000 when unset. First value wins if comma-separated.
WEB_ORIGIN=http://localhost:3000

# Optional. When unset, the API logs verification-email links to the console
# instead of sending real email (see apps/api/src/auth/mailer.service.ts) --
# fine for local dev, but nothing gets delivered. Get a key at
# https://resend.com to send real verification emails.
RESEND_API_KEY=
# Optional. Must be a domain verified in Resend for real sends to work.
# Defaults to Resend's shared onboarding@resend.dev sender otherwise.
RESEND_FROM_EMAIL="LinkedOut <onboarding@resend.dev>"

VALKEY_URL=redis://localhost:6379

MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change-me

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=linkedout
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=linkedout